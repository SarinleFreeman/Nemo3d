but WITHOUT ANY WARRANTY; without even the implied warranty
of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
See the GNU General Public License for more details.

You should have received a copy of the GNU Library General Public License
along with this library.  If not, write to the Free Software Foundation,
Inc., 675 Mass Ave, Cambridge, MA 02139, USA.

Written by E. Robert Tisdale
*/
<ns>extent		(<ns><p><s>m_extent1)(const <ns><p><s>matrix* pM) {
  return *((const <ns>extent*)(pM - 1));
  }
inline static
<ns>extent		(<ns><p><s>m_extent2)(const <ns><p><s>matrix* pM) {
  return *((const <ns>extent*)(pM - 2));
  }

/* Constructor								*/
inline static
<ns><p><s>matrix*	(<ns><p><s>m_new)(<ns>extent m, <ns>extent n) {
  <ns><p><s>scalar**	pp
    = (<ns><p><s>scalar**)<ns>calloc(3+m, sizeof(<ns><p><s>scalar*));
  if (NULL == pp) {
    <ns>message("In function <ns><p><s>m_new(<ns>extent, <ns>extent):\n"
      "unable to allocate memory.");
    }
  else {		/* (NULL != pp)		*/
    *pp = NULL;		     ++pp;
    *((<ns>extent*)pp)	= m; ++pp;
    *((<ns>extent*)pp)	= n; ++pp;
    if (0 < m) {
      if (0 < n) {
	pp[0] = (<ns><p><s>scalar*)<ns><p><s>v_new(n*m);
	if (NULL == pp[0]) {
	  <ns>offset	i = 1;
          for (i = 1; i < m; ++i)
	    pp[i] = NULL;
	  <ns>message("In function <ns><p><s>m_new(<ns>extent, <ns>extent):\n"
	    "unable to allocate memory.");
	  }
	else {		/* (NULL != pp[0])	*/
	  <ns>offset	i = 1;
	  for (i = 1; i < m; ++i)
	    pp[i] = pp[i-1] + n;
	  }
	}
      else {		/* (n <= 0)		*/
	<ns>offset	i = 0;
        for (i = 0; i < m; ++i)
	  pp[i] = NULL;
	}
      }
    }
  return pp;
  }

/* Destructor								*/
inline static
void			(<ns><p><s>m_delete)(<ns><p><s>matrix* pM) {
  if (NULL != pM) {
    <ns><p><s>v_delete(pM[0]);
    <ns>free(pM - 3);
    }
  }

/* Reconstructor							*/
inline static
<ns><p><s>matrix*	(<ns><p><s>m_resize)(<ns><p><s>matrix* *ppM,
    <ns>extent m, <ns>extent n) {
  if (NULL != ppM) {
    (<ns><p><s>m_delete)(*ppM);
    *ppM = (<ns><p><s>m_new)(m, n);
    return *ppM;
    }
  else {
    <ns>message(
"In function <ns><p><s>m_resize(<ns><p><s>matrix**, <ns>extent, <ns>extent):\n"
"invalid pointer to <ns><p><s>matrix*.");
    return NULL;
    }
  }
#else /*<NS>INLINE	*/
/* Functions								*/
<ns>extent		(<ns><p><s>m_extent1)(const <ns><p><s>matrix*);
<ns>extent		(<ns><p><s>m_extent2)(const <ns><p><s>matrix*);
/* Constructor								*/
<ns><p><s>matrix*	(<ns><p><s>m_new)(<ns>extent, <ns>extent);
/* Destructor								*/
void			(<ns><p><s>m_delete)(<ns><p><s>matrix*);
/* Reconstructor							*/
<ns><p><s>matrix*	(<ns><p><s>m_resize)(<ns><p><s>matrix**,
  <ns>extent, <ns>extent);
#endif/*<NS>INLINE	*/

int			(<ns><p><s>m_fprintf)(FILE*,
    const <ns><p><s>matrix*, int, unsigned int, <ns>fmtflags, unsigned int);

#ifdef	<NS>MACROS
#define <ns><p><s>m_extent1(pM) (*((const <ns>extent*)((pM) - 1)))
#define <ns><p><s>m_extent2(pM) (*((const <ns>extent*)((pM) - 2)))
#endif/*<NS>MACROS	*/

#endif /* _<ns><p><s>matrix_h */
