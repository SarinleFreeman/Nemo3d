ifelse(_system_, complex, `
/* Include <precision> precision real 2DBase type definitions.		*/
#include<<ns><p>2DBase.h>
')dnl

/* Include scalar type definitions.					*/
#include<<ns><p><s>scalar.h>

typedef <ns><p><s>scalar*	<ns><p><s>2DBase;

#ifdef	<NS>INLINE
/* Functions								*/
inline static
<ns>index		(<ns><p><s>2D_lower2)(const <ns><p><s>2DBase* pM) {
  return *((const <ns>index*)(pM - 1));
  }
inline static
<ns>index		(<ns><p><s>2D_upper2)(const <ns><p><s>2DBase* pM) {
  return *((const <ns>index*)(pM - 2));
  }
inline static
<ns>extent		(<ns><p><s>2D_extent2)(const <ns><p><s>2DBase* pM) {
  return 1+<ns><p><s>2D_upper2(pM)-<ns><p><s>2D_lower2(pM);
  }
inline static
<ns>index		(<ns><p><s>2D_lower1)(const <ns><p><s>2DBase* pM) {
  return *((const <ns>index*)(pM - 3));
  }
inline static
<ns>index		(<ns><p><s>2D_upper1)(const <ns><p><s>2DBase* pM) {
  return *((const <ns>index*)(pM - 4));
  }
inline static
<ns>extent		(<ns><p><s>2D_extent1)(const <ns><p><s>2DBase* pM) {
  return 1+<ns><p><s>2D_upper1(pM)-<ns><p><s>2D_lower1(pM);
  }

/* Constructor								*/
inline static
<ns><p><s>2DBase*	(<ns><p><s>2D_new)(
    <ns>index lb2, <ns>index ub2, <ns>index lb1, <ns>index ub1) {
  <ns><p><s>scalar**	pp = NULL;
  <ns>index		m = 1 + ub2 - lb2;
  <ns>index		n = 1 + ub1 - lb1;
  if (m < 0) {
    <ns>message(
"In function <ns><p><s>2D_new(<ns>index, <ns>index, <ns>index, <ns>index):\n"
"extent2 is negative.");
    }
  else
  if (n < 0) {
    <ns>message(
"In function <ns><p><s>2D_new(<ns>index, <ns>index, <ns>index, <ns>index):\n"
"extent1 is negative.");
    }
  else {		/* (0 <= m) && (0 <= n)	*/
    pp = (<ns><p><s>scalar**)<ns>calloc(4 + m, sizeof(<ns><p><s>scalar*));
    if (NULL != pp) {
      *((<ns>index*)pp) = ub1; ++pp;
      *((<ns>index*)pp) = lb1; ++pp;
      *((<ns>index*)pp) = ub2; ++pp;
      *((<ns>index*)pp) = lb2; ++pp;
      if (0 < m) {
	if (0 < n) {
	  <ns><p><s>scalar*	p
	    = (<ns><p><s>scalar*)<ns>calloc(m*n, sizeof(<ns><p><s>scalar));
	  if (NULL != p) {
	    pp[0] = p - lb1;
	    { <ns>index	i = 1;
	      for (i = 1; i < m; ++i)
		pp[i] = pp[i-1] + n;
	      }
	    }
	  else {	/* (NULL == p)		*/
	    int	i = 1;
            for (i = 1; i < m; ++i)
	      pp[i] = NULL;
	    <ns>message(
"In function <ns><p><s>2D_new(<ns>index, <ns>index, <ns>index, <ns>index):\n"
"unable to allocate memory.");
	    }
	  }
	else {		/* (n <= 0)		*/
	  int	i = 0;
          for (i = 0; i < m; ++i)
	    pp[i] = NULL;
	  }
	}
      }
    else {		/* (NULL == pp)		*/
      <ns>message(
"In function <ns><p><s>2D_new(<ns>index, <ns>index, <ns>index, <ns>index):\n"
"unable to allocate memory.");
      }
    }
  return pp;
  }

/* Destructor								*/
inline static
void			(<ns><p><s>2D_delete)(<ns><p><s>2DBase* pM) {
  if (NULL != pM) {
    if (NULL != pM[0]) {
      <ns>index	lb1 = <ns><p><s>2D_lower1(pM);
      <ns>free(pM[0] + lb1);
      }
    <ns>free(pM - 4);
    }
  }

/* Reconstructor							*/
inline static
<ns><p><s>2DBase*	(<ns><p><s>2D_resize)(<ns><p><s>2DBase* *ppM,
    <ns>index lb2, <ns>index ub2, <ns>index lb1, <ns>index ub1) {
  if (NULL != ppM) {
    (<ns><p><s>2D_delete)(*ppM);
    *ppM = (<ns><p><s>2D_new)(lb2, ub2, lb1, ub1);
    return *ppM;
    }
  else {
    <ns>message(
"In function <ns><p><s>2D_resize(<ns><p><s>2DBase**, <ns>index, <ns>index,\n"
"  <ns>index, <ns>index): invalid pointer to <ns><p><s>2DBase*.");
    return NULL;
    }
  }
#else /*<NS>INLINE	*/
/* Functions								*/
<ns>index		(<ns><p><s>2D_lower2)(const <ns><p><s>2DBase*);
<ns>index		(<ns><p><s>2D_upper2)(const <ns><p><s>2DBase*);
<ns>extent		(<ns><p><s>2D_extent2)(const <ns><p><s>2DBase*);

<ns>index		(<ns><p><s>2D_lower1)(const <ns><p><s>2DBase*);
<ns>index		(<ns><p><s>2D_upper1)(const <ns><p><s>2DBase*);
<ns>extent		(<ns><p><s>2D_extent1)(const <ns><p><s>2DBase*);
/* Constructor								*/
<ns><p><s>2DBase*	(<ns><p><s>2D_new)(
    <ns>index, <ns>index, <ns>index, <ns>index);
/* Destructor								*/
void			(<ns><p><s>2D_delete)(<ns><p><s>2DBase*);
/* Reconstructor							*/
<ns><p><s>2DBase*	(<ns><p><s>2D_resize)(<ns><p><s>2DBase**,
    <ns>index, <ns>index, <ns>index, <ns>index);
#endif/*<NS>INLINE	*/

int			(<ns><p><s>2D_fprintf)(FILE*,
    const <ns><p><s>2DBase*, int, unsigned int, <ns>fmtflags, unsigned int);

#ifdef	<NS>MACROS
#define <ns><p><s>2D_lower2(pM) (*((const <ns>index*)((pM) - 1)))
#define <ns><p><s>2D_upper2(pM) (*((const <ns>index*)((pM) - 2)))
#define <ns><p><s>2D_extent2(pM) (1+<ns><p><s>2D_upper2(pM)-<ns><p><s>2D_lower2(pM))
#define <ns><p><s>2D_lower1(pM) (*((const <ns>index*)((pM) - 3)))
#define <ns><p><s>2D_upper1(pM) (*((const <ns>index*)((pM) - 4)))
#define <ns><p><s>2D_extent1(pM) (1+<ns><p><s>2D_upper1(pM)-<ns><p><s>2D_lower1(pM))
#endif/*<NS>MACROS	*/

#endif /* _<ns><p><s>2DBase_h */
