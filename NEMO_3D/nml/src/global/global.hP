#include<math.h>
#include<float.h>
#include<limits.h>
#include<stdio.h>
#include<stdlib.h>

#define LOGFILE stderr

#ifndef LONG_8Byte
#define LONG_8Byte long long
#ifdef mem_64BIT
#define LONG_8Byte long
#endif
#endif

/* global type definitions	*/

typedef   signed int	ptrdiff_nml_t;

typedef    size_t	<ns>offset;
typedef    size_t	<ns>extent;
typedef ptrdiff_nml_t	<ns>stride;
typedef ptrdiff_nml_t	<ns>index;

typedef	     float	<ns>single;
typedef      double	<ns>double;
typedef	     signed int	<ns>integer;
typedef	   unsigned int	<ns>logical;
typedef     short       <ns>short ;
typedef      unsigned char        <ns>char ;
typedef     float       <ns>float ;



void * <ns>malloc( <ns>extent ) ;
void * <ns>calloc( <ns>extent , <ns>extent ) ; 
void   <ns>free( void * ) ; 
void   <ns>memory_report( char *tag) ;


void
<ns>message(const char* m);

#define <ns>message(m) fprintf(stderr, (m))

typedef unsigned int <ns>fmtflags;

#define <ns>skipws	= (1 <<  0) /* skip whitespace on input		   */
				    /* field adjustment:		   */
#define <ns>left	= (1 <<  1) /* pad after value			   */
#define <ns>right	= (1 <<  2) /* pad before value			   */
#define <ns>internal	= (1 <<  3) /* pad between sign and value	   */

#define <ns>boolalpha	= (1 <<  4) /* represent true and false symbolically*/
				    /* integer base:			   */
#define <ns>dec	  	= (1 <<  5) /* base 10 output (decimal)		   */
#define <ns>hex	  	= (1 <<  6) /* base 16 output (hexadecimal)	   */
#define <ns>oct	  	= (1 <<  7) /* base  8 output (octal)		   */

#define <ns>scientific  = (1 <<  8) /* floating-point notation d.ddddddEdd */
#define <ns>fixed	= (1 <<  9) /* fixed-point    notation dddd.dd	   */

#define <ns>showbase	= (1 << 10) /* prefix oct by 0 and hex by 0x on output*/
#define <ns>showpoint	= (1 << 11) /* print trailing zeros		   */
#define <ns>showpos	= (1 << 12) /* explicit '+' for positive ints	   */
#define <ns>uppercase	= (1 << 13) /* 'E', 'X' rather than 'e', 'x'	   */
				    /* flags related to:		   */
#define <ns>adjustfield = (1 << 14) /* adjustment			   */
#define <ns>basefield	= (1 << 15) /* integer base			   */
#define <ns>floatfield	= (1 << 16) /* floating-point output		   */

#endif /* _<ns>global_h */
