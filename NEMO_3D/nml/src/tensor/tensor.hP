ifelse(_system_, complex, `
/* Include <precision> precision real tensor type definitions.		*/
#include<<ns><p>tensor.h>
')dnl

/* Include vector type definitions.					*/
#include<<ns><p><s>vector.h>

typedef <ns><p><s>scalar**	<ns><p><s>tensor;

#ifdef	<NS>INLINE
/* Functions								*/
inline static
<ns>extent		(<ns><p><s>t_extent1)(const <ns><p><s>tensor* pT) {
  return *((const <ns>extent*)(pT - 1));
  }
inline static
<ns>extent		(<ns><p><s>t_extent2)(const <ns><p><s>tensor* pT) {
  return *((const <ns>extent*)(pT - 2));
  }
inline static
<ns>extent		(<ns><p><s>t_extent3)(const <ns><p><s>tensor* pT) {
  return *((const <ns>extent*)(pT - 3));
  }

/* Constructor								*/
inline static
<ns><p><s>tensor*	(<ns><p><s>t_new)(
    <ns>extent l, <ns>extent m, <ns>extent n) {
  <ns><p><s>scalar***	ppp
    = (<ns><p><s>scalar***)<ns>calloc(4+l, sizeof(<ns><p><s>scalar**));
  if (NULL != ppp) {
    *ppp = NULL;	     ++ppp;
    *((<ns>extent*)ppp)	= l; ++ppp;
    *((<ns>extent*)ppp)	= m; ++ppp;
    *((<ns>extent*)ppp)	= n; ++ppp;
    if ( 0 < l) {
      if (0 < m) {	/* (0 < l) && (0 < m)	*/
	<ns><p><s>scalar** pp
	  = (<ns><p><s>scalar**)<ns>calloc(1+l*m, sizeof(<ns><p><s>scalar*));
	if (NULL != pp) {
	  *((<ns>extent*)pp) = l*m; ++pp;
	  ppp[0] = pp;
	  { <ns>offset	h = 1;
	    for (h = 1; h < l; ++h)
	      ppp[h] = ppp[h-1] + m;
	    }
	  if (0 < n) {	/* (0 < l) && (0 < m) && (0 < n)	*/
	    ppp[0][0] = (<ns><p><s>scalar*)<ns><p><s>v_new(l*m*n);
	    if (NULL != ppp[0][0]) {
	      <ns>offset	h = 1;
	      for (h = 1; h < l; ++h)
		ppp[h][0] = ppp[h-1][0] + m*n;
	      for (h = 0; h < l; ++h) {
		<ns>offset	i = 1;
		for (i = 1; i < m; ++i)
		  ppp[h][i] = ppp[h][i-1] + n;
		}
	      }

	    else {	/* (NULL == ppp[0][0])	*/
	      <ns>offset	h = 0;
	      for (h = 0; h < l; ++h) {
		<ns>offset	i = 0;
		for (i = 0; i < m; ++i)
		  ppp[h][i] = NULL;
		}
	      <ns>message(
"In function <ns><p><s>t_new(<ns>extent, <ns>extent, <ns>extent):\n"
"unable to allocate memory.");
	      }
	    }
	  else {	/* (n <= 0)		*/
	    <ns>offset		h = 0;
	    for (h = 0; h < l; ++h) {
	      <ns>offset	i = 0;
	      for (i = 0; i < m; ++i)
		ppp[h][i] = NULL;
	      }
	    }
	  }
	else {		/* (NULL == pp)		*/
	  <ns>offset	h = 0;
	  for (h = 0; h < l; ++h)
	    ppp[h] = NULL;
	  <ns>message(
"In function <ns><p><s>t_new(<ns>extent, <ns>extent, <ns>extent):\n"
"unable to allocate memory.");
	  }
	}
      else {		/* (m <= 0)		*/
	<ns>offset	h = 0;
	for (h = 0; h < l; ++h)
	  ppp[h] = NULL;
	}
      }
    }
  else {		/* (NULL == ppp)	*/
    <ns>message(
"In function <ns><p><s>t_new(<ns>extent, <ns>extent, <ns>extent):\n"
"unable to allocate memory.");
    }
  return ppp;
  }

/* Destructor								*/
inline static
void			(<ns><p><s>t_delete)(<ns><p><s>tensor* pT) {
  if (NULL != pT) {
    if (NULL != pT[0]) {
      <ns><p><s>v_delete(pT[0][0]);
      <ns>free(pT[0] - 1);
      }
    <ns>free(pT - 4);
    }
  }

/* Reconstructor							*/
inline static
<ns><p><s>tensor*	(<ns><p><s>t_resize)(<ns><p><s>tensor* *ppT,
    <ns>extent l, <ns>extent m, <ns>extent n) {
  if (NULL != ppT) {
    (<ns><p><s>t_delete)(*ppT);
    *ppT = (<ns><p><s>t_new)(l, m, n);
    return *ppT;
    }
  else {
    <ns>message(
"In function <ns><p><s>t_resize(<ns><p><s>tensor**, <ns>extent, <ns>extent,\n"
"<ns>extent): invalid pointer to <ns><p><s>tensor*.");
    return NULL;
    }
  }
#else /*<NS>INLINE	*/
/* Functions								*/
<ns>extent		(<ns><p><s>t_extent1)(const <ns><p><s>tensor*);
<ns>extent		(<ns><p><s>t_extent2)(const <ns><p><s>tensor*);
<ns>extent		(<ns><p><s>t_extent3)(const <ns><p><s>tensor*);
/* Constructor								*/
<ns><p><s>tensor*	(<ns><p><s>t_new)(<ns>extent, <ns>extent, <ns>extent);
/* Destructor								*/
void			(<ns><p><s>t_delete)(<ns><p><s>tensor*);
/* Reconstructor							*/
<ns><p><s>tensor*	(<ns><p><s>t_resize)(<ns><p><s>tensor**,
  <ns>extent, <ns>extent, <ns>extent);
#endif/*<NS>INLINE	*/

int			(<ns><p><s>t_fprintf)(FILE*,
    const <ns><p><s>tensor*, int, unsigned int, <ns>fmtflags, unsigned int);

#ifdef	<NS>MACROS
#define <ns><p><s>t_extent1(pT) (*((const <ns>extent*)((pT) - 1)))
#define <ns><p><s>t_extent2(pT) (*((const <ns>extent*)((pT) - 2)))
#define <ns><p><s>t_extent3(pT) (*((const <ns>extent*)((pT) - 3)))
#endif/*<NS>MACROS	*/

#endif /* _<ns><p><s>tensor_h */
