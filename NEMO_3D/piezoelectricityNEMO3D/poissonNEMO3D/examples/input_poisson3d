2.5e-9             !y_dop(2)   
2.5e-9             !z_dop(2)
1.0e0              !charge_dop(2)
2.5e-9             !Gate oxide thickness
10                 !k_ox = gate oxide # of grids (k_ox =< kneg)
3.                 !z_contour (nm)
5.                 !gate_voltage (Volts)

&STRUC_LIST_SiP_HOON  iamdummy=0/
5.43e-10           !a0 of Silicon
1.0                !discretization_factor_x
1.0                !discretization_factor_y
1.0                !discretization_factor_z
2.5                !xy_contour; z dimension where to plot xy potential contour (nm)
2.5                !xz_contour; y dimension where to plot xz potential contour (nm)
0.55               !yz_contour; x dimension where to plot xz potential contour (nm)
