/*
subscripting convention:
|T[ 0][0]   T[+1][0]                                                         |
|T[-1][1]   T[ 0][1]   T[+1][1]                                              |
|           T[-1][2]   T[ 0][2]   T[+1][2]                                   |
|                          .          .          .                           |
|                                     .          .          .                |
|                                            T[-1][m-1] T[ 0][m-1] T[+1][m-2]|
|                                                       T[-1][m-1] T[ 0][m-1]|
where <ns>extent m = <ns><p><s>3_extent(pT);				*/
ifelse(_system_, complex, `
/* Include <precision> precision real 3bands type definitions.		*/
#include<<ns><p>3bands.h>
')dnl

/* Include vector type definitions.					*/
#include<<ns><p><s>vector.h>

typedef <ns><p><s>scalar*	<ns><p><s>3bands;

#ifdef	<NS>INLINE
/* Functions								*/
inline static
<ns>extent		(<ns><p><s>3_extent)(const <ns><p><s>3bands* pT) {
  return *((const <ns>extent*)(pT - 2));
  }

inline static
<ns><p><s>3bands*	(<ns><p><s>3_fill)(
    <ns><p><s>3bands* pT, const <ns><p><s>scalar x) {
  <ns><p><s>v_fill(pT[+1], x);
  <ns><p><s>v_fill(pT[ 0], x);
  <ns><p><s>v_fill(pT[-1], x);
  return pT;
  }

inline static
<ns><p><s>3bands*	(<ns><p><s>3_smul)(
    <ns><p><s>3bands* pT, const <ns><p><s>scalar x) {
  <ns><p><s>v_smul(pT[+1], x);
  <ns><p><s>v_smul(pT[ 0], x);
  <ns><p><s>v_smul(pT[-1], x);
  return pT;
  }

inline static
<ns><p><s>3bands*	(<ns><p><s>3_sdiv)(
    <ns><p><s>3bands* pT, const <ns><p><s>scalar x) {
  <ns><p><s>v_sdiv(pT[+1], x);
  <ns><p><s>v_sdiv(pT[ 0], x);
  <ns><p><s>v_sdiv(pT[-1], x);
  return pT;
  }

inline static
<ns><p><s>3bands*	(<ns><p><s>3_sadd)(
    <ns><p><s>3bands* pT, const <ns><p><s>scalar x) {
  <ns><p><s>v_sadd(pT[+1], x);
  <ns><p><s>v_sadd(pT[ 0], x);
  <ns><p><s>v_sadd(pT[-1], x);
  return pT;
  }

inline static
<ns><p><s>3bands*	(<ns><p><s>3_ssub)(
    <ns><p><s>3bands* pT, const <ns><p><s>scalar x) {
  <ns><p><s>v_ssub(pT[+1], x);
  <ns><p><s>v_ssub(pT[ 0], x);
  <ns><p><s>v_ssub(pT[-1], x);
  return pT;
  }

inline static
<ns><p><s>3bands*	(<ns><p><s>3_3cpy)(
    <ns><p><s>3bands* pT, const <ns><p><s>3bands* pU) {
  <ns><p><s>v_vcpy(pT[+1], pU[+1]);
  <ns><p><s>v_vcpy(pT[ 0], pU[ 0]);
  <ns><p><s>v_vcpy(pT[-1], pU[-1]);
  return pT;
  }

/* Constructor								*/
inline static
<ns><p><s>3bands*	(<ns><p><s>3_new)(<ns>extent n) {
  <ns><p><s>scalar**	pT
    = (<ns><p><s>scalar**)<ns>calloc(4*sizeof(<ns><p><s>scalar*));
  if (NULL == pT) {
    <ns>message("In function <ns><p><s>3_new(<ns>extent):\n"
      "unable to allocate memory.");
    }
  else {		/* (NULL != pT)		*/
    *((<ns>extent*)pT) = n;	++pT;
    *pT = <ns><p><s>v_new(n);	++pT;	/* T[-1]			*/
    *pT = <ns><p><s>v_new(n);	++pT;	/* T[ 0]			*/
    *pT = <ns><p><s>v_new(n);	--pT;	/* T[+1]			*/
    }
  return pT;
  }
inline static
<ns><p><s>3bands*	(<ns><p><s>3_clone)(const <ns><p><s>3bands* pU) {
  return <ns><p><s>3_3cpy(<ns><p><s>3_new(<ns><p><s>3_extent(pU)), pU);
  }

/* Destructor								*/
inline static
void			(<ns><p><s>3_delete)(<ns><p><s>3bands* pT) {
  if (NULL != pT) {
    ++pT; <ns><p><s>v_delete(*pT);	/* T[+1]			*/
    --pT; <ns><p><s>v_delete(*pT);	/* T[ 0]			*/
    --pT; <ns><p><s>v_delete(*pT);	/* T[-1]			*/
    --pT; <ns>free(pT);
    }
  }

/* Reconstructor							*/
inline static
<ns><p><s>3bands*	(<ns><p><s>3_resize)(<ns><p><s>3bands* *ppT,
    <ns>extent n) {
  if (NULL != ppT) {
    (<ns><p><s>3_delete)(*ppT);
    *ppT = (<ns><p><s>3_new)(n);
    return *ppT;
    }
  else {
    <ns>message(
	"In function <ns><p><s>3_resize(<ns><p><s>3bands**, <ns>extent):\n"
	"invalid pointer to <ns><p><s>3bands*.");
    return NULL;
    }
  }
#else /*<NS>INLINE	*/
/* Functions								*/
<ns>extent		(<ns><p><s>3_extent)(const <ns><p><s>3bands*);
<ns><p><s>3bands*	(<ns><p><s>3_fill)(
    <ns><p><s>3bands*, const <ns><p><s>scalar);
<ns><p><s>3bands*	(<ns><p><s>3_smul)(
    <ns><p><s>3bands*, const <ns><p><s>scalar);
<ns><p><s>3bands*	(<ns><p><s>3_sdiv)(
    <ns><p><s>3bands*, const <ns><p><s>scalar);
<ns><p><s>3bands*	(<ns><p><s>3_sadd)(
    <ns><p><s>3bands*, const <ns><p><s>scalar);
<ns><p><s>3bands*	(<ns><p><s>3_ssub)(
    <ns><p><s>3bands*, const <ns><p><s>scalar);
<ns><p><s>3bands*	(<ns><p><s>3_3cpy)(
    <ns><p><s>3bands*, const <ns><p><s>3bands*);
<ns><p><s>vector*	(<ns><p><s>v_v3dot)(
    <ns><p><s>vector*, const <ns><p><s>vector*, const <ns><p><s>3bands*);
<ns><p><s>vector*	(<ns><p><s>v_solveTridiagonal)(
    <ns><p><s>vector*, const <ns><p><s>3bands*, const <ns><p><s>vector*);
/* Constructor								*/
<ns><p><s>3bands*	(<ns><p><s>3_new)(<ns>extent);
<ns><p><s>3bands*	(<ns><p><s>3_clone)(const <ns><p><s>3bands* pU);
/* Destructor								*/
void			(<ns><p><s>3_delete)(<ns><p><s>3bands*);
/* Reconstructor							*/
<ns><p><s>3bands*	(<ns><p><s>3_resize)(<ns><p><s>3bands**,
			    <ns>extent);
#endif/*<NS>INLINE	*/

int			(<ns><p><s>3_fprintf)(FILE*,
    const <ns><p><s>3bands*, int, unsigned int, <ns>fmtflags, unsigned int);

#ifdef	<NS>MACROS
#define <ns><p><s>3_extent(pT) (*((const <ns>extent*)((pT) - 2)))
#define <ns><p><s>3_clone(pT) \
	<ns><p><s>3_3cpy(<ns><p><s>3_new(<ns><p><s>3_extent(pT)), (pT))
#endif/*<NS>MACROS	*/

#endif /* _<ns><p><s>3bands_h */
