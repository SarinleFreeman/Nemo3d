dnl Process this file with autoconf to produce a configure script.
AC_INIT(etc/notice.m)
AM_INIT_AUTOMAKE(eigen,0.2)

dnl Checks for programs.
AC_PROG_AWK
AC_PROG_INSTALL
AC_PROG_LN_S
AC_PROG_CC

dnl Checks for libraries.
AC_PROG_RANLIB

dnl Replace `main' with a function in -lblas:
AC_CHECK_LIB(blas, zswap)
dnl Replace `main' with a function in -leigen:
AC_CHECK_LIB(eigen, eigensolve_lanczos)
dnl Replace `main' with a function in -lf77math:
AC_CHECK_LIB(f77math, main)
dnl Replace `main' with a function in -lf90math:
AC_CHECK_LIB(f90math, main)
dnl Replace `main' with a function in -lfio:
AC_CHECK_LIB(fio, main)
dnl Replace `main' with a function in -llapack:
AC_CHECK_LIB(lapack, ztrevc)
dnl Replace `main' with a function in -lm:
AC_CHECK_LIB(m, main)
dnl Replace `main' with a function in -lnml:
AC_CHECK_LIB(nml, Cvectr)

dnl Checks for header files.
AC_HEADER_STDC

dnl Checks for typedefs, structures, and compiler characteristics.
AC_C_CONST

dnl Checks for library functions.
AC_FUNC_VPRINTF


AC_OUTPUT(Makefile)
