dnl Process this file with autoconf to produce a configure script.
AC_INIT(nemo3d/src/top/run3d.c)
AM_INIT_AUTOMAKE(nemo3d,0.2)

dnl Checks for programs.
AC_PROG_CXX
AC_PROG_CC
AC_PROG_LN_S
AC_PROG_MAKE_SET
AC_PROG_INSTALL

dnl Checks for libraries.
AC_PROG_RANLIB

dnl Checks for header files.
AC_HEADER_STDC
AC_CHECK_HEADERS(run3d.h)

dnl Checks for typedefs, structures, and compiler characteristics.
AC_C_CONST
AC_TYPE_SIZE_T
AC_STRUCT_TM

dnl Checks for library functions.
AC_TYPE_SIGNAL
AC_FUNC_STRFTIME
AC_FUNC_VPRINTF
AC_CHECK_FUNCS(strstr strtod strtol)

AC_OUTPUT(Makefile nml/src/Makefile eigen/Makefile nemo3d/Makefile)

